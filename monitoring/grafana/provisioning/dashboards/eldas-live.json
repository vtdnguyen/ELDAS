{
  "annotations": {"list": []},
  "description": "ELDAS Live overview — pick one (scenario, scheduler) tuple to see the current run. Click 'Host detail' link to drill into a specific host.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Host detail",
      "type": "dashboards",
      "tags": ["eldas", "host"],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "liveNow": true,
  "panels": [
    {
      "id": 100, "type": "row",
      "title": "Overview — $scenario / $scheduler",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false, "panels": []
    },
    {
      "id": 1, "type": "stat",
      "title": "Total energy (kWh)",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A", "expr": "eldas_total_energy_kwh{scenario=\"$scenario\", scheduler=\"$scheduler\"}"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 3,
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "green", "value": null},
          {"color": "orange", "value": 0.5},
          {"color": "red", "value": 1.0}]}}},
      "options": {"colorMode": "background", "graphMode": "area", "textMode": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "type": "stat",
      "title": "SLA violations (last 1m)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A",
        "expr": "sum(increase(eldas_sla_violations_total{scenario=\"$scenario\", scheduler=\"$scheduler\"}[1m]))"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0,
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "green", "value": null},
          {"color": "orange", "value": 1},
          {"color": "red", "value": 10}]}}},
      "options": {"colorMode": "background", "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3, "type": "stat",
      "title": "Pending tasks",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A", "expr": "eldas_pending_tasks{scenario=\"$scenario\", scheduler=\"$scheduler\"}"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0}},
      "options": {"colorMode": "value", "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4, "type": "stat",
      "title": "Schedule rate (tasks/s)",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A",
        "expr": "sum(rate(eldas_tasks_scheduled_total{scenario=\"$scenario\", scheduler=\"$scheduler\"}[30s]))"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 2}},
      "options": {"colorMode": "value", "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 5, "type": "stat",
      "title": "Cluster mean CPU util",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A",
        "expr": "avg(eldas_host_cpu_util{scenario=\"$scenario\", scheduler=\"$scheduler\"})"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "min": 0, "max": 1,
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "blue", "value": null},
          {"color": "green", "value": 0.3},
          {"color": "orange", "value": 0.7},
          {"color": "red", "value": 0.9}]}}},
      "options": {"colorMode": "background", "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 6, "type": "gauge",
      "title": "Sim clock (s)",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A",
        "expr": "eldas_sim_clock_seconds{scenario=\"$scenario\", scheduler=\"$scheduler\"}"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0}},
      "options": {"showThresholdLabels": false, "showThresholdMarkers": false,
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },

    {
      "id": 200, "type": "row",
      "title": "Per-host heatmap — spread vs pack signature",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false, "panels": []
    },
    {
      "id": 10, "type": "state-timeline",
      "title": "Host CPU utilisation (10 rows — one per host)",
      "description": "Uses 'max by (host_id)' to collapse to one row per host regardless of how many (scenario, scheduler) tuples Prometheus has cached. Single-select filters keep only the active run.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A",
        "expr": "max by (host_id) (eldas_host_cpu_util{scenario=\"$scenario\", scheduler=\"$scheduler\"})",
        "legendFormat": "host {{host_id}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1,
        "custom": {"lineWidth": 0, "fillOpacity": 90},
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "#1f78b4", "value": null},
          {"color": "#33a02c", "value": 0.20},
          {"color": "#b2df8a", "value": 0.40},
          {"color": "#fdbf6f", "value": 0.60},
          {"color": "#ff7f00", "value": 0.80},
          {"color": "#e31a1c", "value": 0.95}]},
        "color": {"mode": "thresholds"}}},
      "options": {"mergeValues": false, "showValue": "never", "alignValue": "left", "rowHeight": 0.9,
        "legend": {"displayMode": "list", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "id": 11, "type": "state-timeline",
      "title": "Host GPU utilisation",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A",
        "expr": "max by (host_id) (eldas_host_gpu_util{scenario=\"$scenario\", scheduler=\"$scheduler\"})",
        "legendFormat": "host {{host_id}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1,
        "custom": {"lineWidth": 0, "fillOpacity": 90},
        "thresholds": {"mode": "absolute", "steps": [
          {"color": "#1f78b4", "value": null},
          {"color": "#33a02c", "value": 0.125},
          {"color": "#b2df8a", "value": 0.25},
          {"color": "#fdbf6f", "value": 0.50},
          {"color": "#ff7f00", "value": 0.75},
          {"color": "#e31a1c", "value": 0.95}]},
        "color": {"mode": "thresholds"}}},
      "options": {"mergeValues": false, "showValue": "never", "rowHeight": 0.9,
        "legend": {"displayMode": "list", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "single"}}
    },

    {
      "id": 300, "type": "row",
      "title": "Power, queue & SLA breakdown",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
      "collapsed": false, "panels": []
    },
    {
      "id": 20, "type": "timeseries",
      "title": "Per-host power draw (stacked, W)",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 23},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A",
        "expr": "max by (host_id) (eldas_host_power_watt{scenario=\"$scenario\", scheduler=\"$scheduler\"})",
        "legendFormat": "host {{host_id}}"}],
      "fieldConfig": {"defaults": {"unit": "watt",
        "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 35,
          "stacking": {"mode": "normal", "group": "A"},
          "showPoints": "never", "gradientMode": "opacity"}}},
      "options": {"legend": {"displayMode": "table", "placement": "right",
          "calcs": ["lastNotNull", "mean"], "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 21, "type": "timeseries",
      "title": "Pending queue vs scheduled rate",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 23},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [
        {"refId": "A", "expr": "eldas_pending_tasks{scenario=\"$scenario\", scheduler=\"$scheduler\"}",
          "legendFormat": "pending"},
        {"refId": "B",
          "expr": "sum(rate(eldas_tasks_scheduled_total{scenario=\"$scenario\", scheduler=\"$scheduler\"}[30s]))",
          "legendFormat": "scheduled rate"}
      ],
      "fieldConfig": {"defaults": {
        "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}},
        "overrides": [{"matcher": {"id": "byName", "options": "scheduled rate"},
          "properties": [{"id": "custom.axisPlacement", "value": "right"}, {"id": "unit", "value": "ops"}]}]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi"}}
    },
    {
      "id": 30, "type": "timeseries",
      "title": "SLA violations rate by QoS",
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A",
        "expr": "sum by (qos) (rate(eldas_sla_violations_total{scenario=\"$scenario\", scheduler=\"$scheduler\"}[30s]))",
        "legendFormat": "{{qos}}"}],
      "fieldConfig": {"defaults": {"unit": "ops",
        "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "table", "placement": "right",
          "calcs": ["sum", "lastNotNull"], "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 31, "type": "piechart",
      "title": "SLA violation share by QoS",
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 32},
      "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
      "targets": [{"refId": "A",
        "expr": "sum by (qos) (eldas_sla_violations_total{scenario=\"$scenario\", scheduler=\"$scheduler\"})",
        "legendFormat": "{{qos}}"}],
      "fieldConfig": {"defaults": {"unit": "none"}},
      "options": {"legend": {"displayMode": "list", "placement": "right",
          "showLegend": true, "values": ["value", "percent"]},
        "pieType": "donut",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "tooltip": {"mode": "single"}}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["eldas", "live"],
  "templating": {
    "list": [
      {
        "name": "scenario", "label": "Scenario", "type": "query",
        "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
        "query": {"query": "label_values(eldas_host_cpu_util, scenario)", "refId": "Scenario"},
        "current": {"text": "HIGH", "value": "HIGH", "selected": false},
        "includeAll": false, "multi": false,
        "refresh": 1, "sort": 1
      },
      {
        "name": "scheduler", "label": "Scheduler", "type": "query",
        "datasource": {"type": "prometheus", "uid": "eldas-prometheus"},
        "query": {"query": "label_values(eldas_host_cpu_util{scenario=\"$scenario\"}, scheduler)", "refId": "Scheduler"},
        "current": {"text": "k8s", "value": "k8s", "selected": false},
        "includeAll": false, "multi": false,
        "refresh": 1, "sort": 1
      }
    ]
  },
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "ELDAS Live — Overview",
  "uid": "eldas-live",
  "version": 3,
  "weekStart": ""
}
